  "strings" : {
    "%@ 個檔案" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个文件"
          }
        }
      }
    },
    "%@ 尚未登入。請先打開「終端機」執行一次 %@ 並完成登入，再回來重試。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ isn’t signed in. Open Terminal, run %2$@ once and sign in, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 尚未登录。请先打开“终端”运行一次 %2$@ 并完成登录，然后回来重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 尚未登入。請先打開「終端機」執行一次 %2$@ 並完成登入，再回來重試。"
          }
        }
      }
    },
